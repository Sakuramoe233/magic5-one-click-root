# 文本文件统一 LF（不随 Windows 检出变成 CRLF）
* text=auto eol=lf

# Windows 批处理为 GBK(cp936) + CRLF：禁止 git 做换行/编码转换，避免中文标题乱码
*.bat -text

# 设备端脚本必须是 LF，否则 /system/bin/sh 会报 "\r: not found"
*.sh   text eol=lf
*.ps1  text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.md   text eol=lf
*.conf text eol=lf
*.json text eol=lf
